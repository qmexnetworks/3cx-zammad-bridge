#!/bin/sh
# Pre-commit checks. Enable with: git config core.hooksPath hooks
set -eu

cd "$(git rev-parse --show-toplevel)"

if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "pre-commit: golangci-lint not found on PATH; install v2: https://golangci-lint.run/docs/welcome/install/" >&2
	exit 1
fi

# Formatting (gofumpt, goimports) and vet are part of the golangci-lint config.
golangci-lint run ./...
go test ./...
